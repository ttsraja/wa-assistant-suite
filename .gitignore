# =============================================================================
# WA Assistant Suite — .gitignore
# Goal: ship a clone that can install & run; never commit secrets or local runtime.
# =============================================================================

# --- Dependencies (reinstall via npm install) ---------------------------------
node_modules/
**/node_modules/
npm-cache/
**/npm-cache/

# --- Build / export outputs (regenerate via scripts) -------------------------
# Next.js
.next/
**/.next/
# Static UI export (npm run build:ui)
out/
**/out/
# Generic compile dirs
dist/
**/dist/
.turbo/
*.tsbuildinfo

# Generic "build/" folders — BUT keep Electron packaging resources in git
build/
# Required for electron-builder + public package icons (must be in the clone)
!apps/desktop/build/
!apps/desktop/build/**

# Desktop packaged installers (publish via GitHub Releases; do not commit binaries)
apps/desktop/release/
apps/desktop/.runtime/

# --- Environment & secrets (never commit) ------------------------------------
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
# Allow shared templates only
!.env.example
!**/.env.example

# Google / OAuth / API material
credentials.json
**/credentials.json
token.json
**/token.json
*credentials*.json
*service-account*.json
**/client_secret*.json
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
*.keystore

# --- WhatsApp session / Chromium cache ---------------------------------------
.wwebjs_auth/
.wwebjs_cache/
**/.wwebjs_auth/
**/.wwebjs_cache/

# --- Local databases & Prisma runtime ----------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# App upgrade/runtime meta (local data dir / package root during dev)
app-meta.json
**/app-meta.json
app-meta.pre-upgrade-*.json
**/app-meta.pre-upgrade-*.json

# --- Logs --------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor -------------------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Test / coverage ---------------------------------------------------------
coverage/
.nyc_output/

# --- Agent / local scratch (not product source) ------------------------------
.claude/
memory/
.warp/

# --- Workspace lockfiles (root package-lock.json IS committed) ---------------
apps/*/package-lock.json
