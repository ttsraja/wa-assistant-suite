# Optional overrides (copy to apps/core-engine/.env for browser-dev engine)
# Never commit real secrets.

# WA_ASSISTANT_DATA_DIR=
# WA_ENGINE_PORT=3001
# WA_ENGINE_HOST=127.0.0.1
# WA_UI_ORIGIN=http://localhost:3000
# PUPPETEER_EXECUTABLE_PATH=
# WA_PUPPETEER_HEADLESS=new

# Google OAuth (Calendar / Tasks) — or place credentials.json in the data dir
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
