datasource db {
  provider = "sqlite"
  // Overridden at runtime via DATABASE_URL (see src/paths.js). Default keeps CLI db:push working from apps/core-engine.
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Config {
  id            Int     @id @default(1)
  status        String  @default("ON")
  customContext String  @default("")
  /// Global Master Agent reply tone (auto | formal | casual | friendly | concise | tamil | tanglish).
  /// Injected into the system prompt for all LLM providers. Per-contact policy tone can override.
  responseTone  String  @default("auto")
  /// Display name of the WhatsApp account owner the assistant represents.
  /// Defaults from linked WA pushname; editable in the control center.
  ownerName     String  @default("")
}

model ConversationLog {
  id         String   @id @default(uuid())
  chatId     String
  senderName String
  message    String
  response   String
  toolsUsed  String?
  createdAt  DateTime @default(now())
}

// Feature #1 – LLM Provider Configuration
model LLMConfig {
  id        Int      @id @default(1)
  provider  String   @default("ollama")   // ollama | gemini | claude | openai | grok
  modelName String   @default("gemma4:latest")
  apiKey    String?
  baseUrl   String?  // for Grok / custom OpenAI-compat endpoints
  updatedAt DateTime @updatedAt
}

// Feature #2 – Calendar / Tasks Provider Configuration
model CalendarConfig {
  id              Int      @id @default(1)
  calendarProvider String  @default("google") // google | macos | windows
  tasksProvider    String  @default("google") // google | macos | windows
  updatedAt        DateTime @updatedAt
}

// Feature #3 – Per-contact policy, tone & restrictions
model ContactPolicy {
  id                  Int      @id @default(autoincrement())
  contactId           String   @unique  // WhatsApp ID, e.g. 919962951116@c.us
  displayName         String
  tone                String   @default("auto")    // auto | formal | casual | tamil | tanglish
  infoLevel           String   @default("full")    // full | limited | minimal
  restrictedTopics    String?  // JSON array of strings
  requiresApproval    Boolean  @default(false)
  customInstructions  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Feature #3 – Approval queue for sensitive/restricted messages
model PendingApproval {
  id          Int      @id @default(autoincrement())
  contactId   String
  senderName  String
  message     String
  aiDraft     String?  // AI-generated draft for the owner to edit before sending
  status      String   @default("pending")  // pending | approved | rejected | sent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}